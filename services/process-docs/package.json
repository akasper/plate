{
  "name": "@plate/process-docs",
  "private": true,
  "version": "0.0.1",
  "description": "plateprocess.dev — PLATE process docs website and read-only MCP (Worker)",
  "type": "module",
  "scripts": {
    "pretest": "test -f generated/bundle.json || cp generated/bundle.stub.json generated/bundle.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "bundle": "tsx scripts/bundle-docs.ts",
    "bundle:release": "REQUIRE_EXACT_TAG=1 tsx scripts/bundle-docs.ts",
    "check:links": "tsx scripts/check-doc-links.ts",
    "dev": "npm run bundle && wrangler dev",
    "deploy": "npm run bundle:release && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "marked": "^15.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.168.0",
    "zod": "^3.24.0"
  }
}